{
  "name": "wzaielamri-github-io",
  "version": "1.0.0",
  "private": true,
  "description": "Build scripts for wzaielamri.github.io (academicpages / Minimal Mistakes)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wzaielamri/wzaielamri.github.io.git"
  },
  "keywords": [
    "jekyll",
    "academicpages",
    "personal-website"
  ],
  "author": "Wadhah Zai El Amri",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wzaielamri/wzaielamri.github.io/issues"
  },
  "homepage": "https://wzaielamri.github.io",
  "engines": {
    "node": ">= 12"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "onchange": "^7.1.0",
    "uglify-js": "^3.17.4"
  },
  "scripts": {
    "uglify": "uglifyjs assets/js/vendor/jquery/jquery-1.12.4.min.js assets/js/plugins/jquery.fitvids.js assets/js/plugins/jquery.greedy-navigation.js assets/js/plugins/jquery.magnific-popup.js assets/js/plugins/jquery.smooth-scroll.min.js assets/js/plugins/stickyfill.min.js assets/js/_main.js -c -m -o assets/js/main.min.js",
    "watch:js": "onchange \"assets/js/**/*.js\" -e \"assets/js/main.min.js\" -- npm run build:js",
    "build:js": "npm run uglify"
  }
}
